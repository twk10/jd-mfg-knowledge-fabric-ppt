# Copy this file to ".env" for local development and fill in real values.
# On Replit, set these as Secrets instead (never commit real secrets).

# --- Required ---------------------------------------------------------------

# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Optional ---------------------------------------------------------------

# Email domain allowed to view the deck (defaults to thoughtworks.com).
# NOTE: this is a self-asserted domain check, not a verified identity — there
# is no OAuth client involved, so anyone can type an email ending in this
# domain and get in. Treat it as a soft speed-bump, not real authentication.
ALLOWED_EMAIL_DOMAIN=thoughtworks.com

# Explicit public URL override. Usually NOT needed:
# - Inside the Replit workspace, REPLIT_DEV_DOMAIN is detected automatically.
# - Locally, http://localhost:PORT is used automatically.
# Set this to your deployment URL (e.g. https://your-deck.replit.app) if the
# auto-detected value is wrong.
# PUBLIC_URL=https://your-deck.replit.app

# Port to listen on (Replit sets this for you; defaults to 3000 locally).
PORT=3000
